<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.acme.legacy.domain">
    <class name="Customer" table="T_CUSTOMER">
        <id name="id" column="CUSTOMER_ID" type="long">
            <generator class="native"/>
        </id>
        <property name="fullName" column="FULL_NAME" length="120" not-null="true"/>
        <property name="email" column="EMAIL" length="120" not-null="true"/>
        <property name="active" column="ACTIVE_FLAG" type="boolean"/>
    </class>
</hibernate-mapping>
