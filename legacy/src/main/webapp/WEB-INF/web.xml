<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC
    "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
    "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>

    <display-name>ACME Customer Ledger</display-name>

    <listener>
        <listener-class>com.acme.legacy.web.LegacyApplicationListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>menu</servlet-name>
        <servlet-class>com.acme.legacy.web.MenuServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>menu</servlet-name>
        <url-pattern>/menu</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>customers</servlet-name>
        <servlet-class>com.acme.legacy.web.CustomerListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>customers</servlet-name>
        <url-pattern>/customers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>customer-save</servlet-name>
        <servlet-class>com.acme.legacy.web.CustomerSaveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>customer-save</servlet-name>
        <url-pattern>/customer-save</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>status</servlet-name>
        <servlet-class>com.acme.legacy.web.SystemStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>status</servlet-name>
        <url-pattern>/status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>export</servlet-name>
        <servlet-class>com.acme.legacy.web.CustomerExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>export</servlet-name>
        <url-pattern>/customers-export.xml</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
